# Copy this file to .env for local overrides. mise loads .env automatically
# for every task. Never commit .env or real credentials.

APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://budget@localhost:5433/budget_tracker?sslmode=disable

# Serve compiled assets from disk during local development so css:watch works.
# `mise run run` sets this automatically; leave empty for embedded assets.
WEB_STATIC_DIR=web/static

# Used by PostgreSQL-backed integration tests.
TEST_DATABASE_URL=postgres://budget@localhost:5433/budget_tracker?sslmode=disable
